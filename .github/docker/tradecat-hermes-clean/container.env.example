# Copy to docker/tradecat-hermes-clean/container.env for local use.
# This file is safe to commit; container.env is ignored by .gitignore.

# --- Hermes provider keys ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Codex CLI ---
# CODEX_HOME=/home/ubuntu/.codex

# --- In-container project copy ---
# Set to 1 only when you intentionally want startup to reset
# /workspace/tradecat-public from the image seed.
TRADECAT_CONTAINER_REFRESH_REPO=0

# --- Telegram gateway ---
# HERMES_TELEGRAM_BOT_TOKEN=
# HERMES_TELEGRAM_ALLOWED_USER_IDS=

# --- Network proxy from Docker container back to WSL2/host proxy ---
# If your proxy listens on the WSL2 host at 7890, keep host.docker.internal.
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,host.docker.internal

# --- TradeCat public-readonly / paper runtime ---
TRADECAT_AUTO_PAPER_RUNTIME_DIR=/home/ubuntu/.tradecat-runtime/auto-paper
TRADECAT_AUTO_PAPER_AUTONOMY_ENABLED=0
TRADECAT_AUTO_PAPER_CYCLE_TIMEOUT_SECONDS=6000
